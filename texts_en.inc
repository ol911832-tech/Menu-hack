static const SettingEn kSettingsEn[] = {
	{"enabled", "Enabled", "Master switch. When off, the mod changes nothing."},
	{"language", "Idioma / Language", "Language of the mod's in-game menus, notices and texts. Applies to anything opened from now on. With English selected, this settings page is shown in English too (reopen it after changing the language).\n\nIdioma de los menus, avisos y textos del mod dentro del juego."},
	{"t-measure", "Measure", ""},
	{"profiler", "On-screen profiler", "Shows inside the level how long each part takes per frame (logic, triggers, visibility, particles and the rest, which is mostly drawing), the FPS and the worst frame of the last half second."},
	{"hud", "FPS and hardware monitor", "Counter at the top left, like MSI Afterburner's: GPU usage, temperature, memory and power draw, CPU usage and frequency, RAM, FPS, 1% low, 0.1% low and a frame time graph. Works even if 'Enabled' is off. When turned off it disappears and nothing keeps running."},
	{"t-visual", "Lighter visuals", ""},
	{"particles", "Particles (%)", "Percentage of particles that are created. 100 = normal. 0 = no particles (not drawn and not computed). In-between values apply when entering the level."},
	{"no-glow", "No glow", "Does not create object glow. Applies when entering the level."},
	{"no-shaders", "No shaders", "Ignores shader triggers (waves, pixelate, blur, etc.). Applies when entering the level."},
	{"no-shake", "No camera shake", "Ignores shake triggers."},
	{"force-ldm", "Force low detail (LDM)", "Enters every level with Low Detail Mode on, without ticking it on each one. Only has an effect on levels that have objects marked as high detail."},
	{"t-latency", "Low latency", ""},
	{"flush-queue", "Flush GPU queue", "Waits for the graphics card to finish each frame before starting the next one, so frames do not pile up in a queue. May lower FPS."},
	{"high-priority", "High CPU priority", "Raises Geometry Dash's priority in Windows so other programs do not take the CPU away from it. Reduces spikes, not average latency."},
	{"no-vsync", "Force V-Sync off", "Turns vertical sync off when the game opens and when entering each level."},
	{"t-system", "Windows (Geometry Dash only)", "The \"Optimizer: status\" button in the main menu and the pause menu shows how each item ended up, as read from Windows."},
	{"watchdog", "Continuous watchdog", "Every 2 seconds it checks CPU, GPU and I/O priority, cores, thread boost, timer and power plan, and puts them back if another program changed them. Runs on a separate lowest-priority thread, pinned to core 0 when Windows allows it, so the game never waits for it. Only acts on options that are on."},
	{"helper", "External watchdog (helper)", "Installs a very small helper program that watches Geometry Dash from outside, with administrator rights, pinned to core 0 and with all its priorities at minimum. Windows asks for permission ONCE, when installing it; after that it starts with the game, with no prompts, and closes when the game closes. With it, high I/O priority can be applied. Off: uninstalls it (asks for permission once)."},
	{"ram-purge", "Purge RAM standby list", "Like ISLC: while the game is open, the helper empties the memory standby list when both conditions below are met. Needs the external watchdog."},
	{"ram-standby-mb", "Purge if the standby list is at least (MB)", "First condition. In ISLC: \"The list size is at least\"."},
	{"ram-free-mb", "...and free memory is lower than (MB)", "Second condition. In ISLC: \"Free memory is lower than\". If you enter more than your total RAM, this condition is always met and it will purge every time the list reaches the size above."},
	{"gpu-priority", "High GPU priority", "Asks Windows to have the graphics card serve Geometry Dash first."},
	{"io-priority", "High I/O priority", "On: high disk priority for the game. Off: normal. Windows only allows \"high\" if the game is run as administrator; if it is refused, the status button says so."},
	{"affinity", "No core 0 and no SMT", "The game uses a single thread per physical core and does not use core 0. On an 8-core, 16-thread CPU that leaves 2, 4, 6, 8, 10, 12, 14. On Intel CPUs with P and E cores only the P (fast) cores are used; E cores are left out."},
	{"park-apps", "Programs on threads 0 and 1", "Opens a list of running programs. The ones you tick (Discord, the browser...) are kept on threads 0 and 1 only while Geometry Dash is open, so they do not use the game's cores. Also applies to ones you open later. When you untick them or close the game they use all cores again. Does not ask for administrator rights; programs run as administrator are not listed."},
	{"no-boost", "Disable thread boost", "Turns off Windows' \"dynamic thread priority boost\" for the game: its threads always stay at their base priority."},
	{"timer", "0.5 ms timer", "Asks Windows for the highest clock resolution while the game is open."},
	{"power-plan", "Power plan", "Use the arrows to pick one of this PC's power plans. \"No cambiar\" leaves it as it is. The plan applies to all of Windows; when the game closes, the previous one is restored."},
	{"t-compat", "GeometryDash.exe compatibility", "The same checkboxes as the game's Properties > Compatibility. They do not ask for administrator rights and apply the next time you open the game."},
	{"c-fso-off", "Disable fullscreen optimizations", "Ticks the \"Disable fullscreen optimizations\" checkbox of GeometryDash.exe. Off: unticks it."},
	{"c-dpi-app", "Override high DPI scaling (Application)", "Ticks \"Override high DPI scaling behavior\" with scaling performed by \"Application\". Off: unticks it."},
	{"rec-title", "Screen recording", "Records the game to video, with sound on the tracks you choose. Quick menu at any time with Alt+F12 and screenshot with Alt+F11 (both keys can be changed from that menu); Alt+F10 saves the replay and Alt+F9 starts or stops a recording. Videos go to the Videos\\GD Optimizer folder."},
	{"rec-on", "Instant replay", "Records all the time in the background and keeps only the last few minutes. With Alt+F10 (or from the Alt+F12 menu) they are saved to an MP4. While on, it uses the graphics card's video encoder and writes to a temporary folder on disk (about 150 MB per minute at 20 Mbps), which is deleted automatically."},
	{"rec-seconds", "Replay length (seconds)", "How much is kept and saved. 300 = 5 minutes. Can also be changed from the Alt+F12 menu."},
	{"rec-height", "Video resolution", "Video height: 720p, 1080p, 1440p or 2160p (4K). If it is larger than the game window, the image is upscaled. \"Ventana\" (window) records at the exact window size. Can also be changed from the Alt+F12 menu."},
	{"rec-fps", "Video FPS", "Frames per second of the video. Maximum 240. For them to be real, the game has to run at least at that FPS. At 120 or 240 it is worth raising the quality (Mbps). Can also be changed from the Alt+F12 menu."},
	{"rec-mbps", "Quality (Mbps)", "The higher, the better the image and the larger the files. As a guide at 60 fps: 20 for 1080p, 35 for 1440p, 60 for 4K. At 120 fps, 50% more; at 240, double."},
	{"rec-menu", "Quick recording menu (Alt+F12)", "Off: the quick menu key (Alt+F12 or the one you set) does nothing and the black menu on the left does not open. Instant replay, Alt+F10, Alt+F9 and screenshots keep working if they are on."},
	{"rec-notify", "On-screen recording notices", "Shows a notice when a video or screenshot is saved, when a recording starts, when a key is changed and when an option is not available. Off: none are shown, except errors."},
	{"rec-audio", "Video sound", "No sound: the video has no sound. One track: the game and your microphone mixed in a single track. Two tracks: the game on track 1 and the microphone on track 2, separate so you can raise, lower or remove each one when editing (the Windows player only plays the first; to hear the other use VLC or an editor). Can also be changed from the Alt+F12 menu."},
	{"t-win", "Permanent Windows tweaks", "They change the registry, services or boot settings of all of Windows, not just the game, and stay even after you close Geometry Dash. When applying, Windows asks for administrator permission once. Each switch shows the real state of the system."},
	{"admin-once", "Administrator permission only once", "Installs a helper (gdopt-admin.exe) so that turning the tweaks in this section, the keyboard core and point 5 of 'Keyboard without Windows delays' on or off no longer shows the Windows administrator prompt every time. When you turn it on, the prompt appears one last time. Security: the helper only knows how to turn on or off the tweaks that ship with this mod; it accepts no commands, paths or values, and it is installed in Program Files, where only an administrator can change it. In exchange, any program already running as your user could turn those same tweaks on or off without Windows asking you (nothing more than that). Still asking for permission: installing or removing the helpers and deleting restore points. After updating the mod it shows as off: turn it on again. Off: removes the helper."},
	{"restore-points", "Restore points", "Opens a window to create a Windows restore point, see the existing ones and delete them. It is a good idea to create one before touching the tweaks below. The first time, Windows asks for permission to install a helper; after that, creating and listing ask for nothing. Deleting a point always asks for permission."},
	{"w-priority-sep", "Foreground priority (0x2A)", "Sets Win32PrioritySeparation to 0x2A to give more CPU to the foreground program. Off: back to 2, the Windows value."},
	{"w-power-throttling", "Disable power throttling", "Stops Windows from slowing programs down to save power (PowerThrottlingOff). Off: deletes the value."},
	{"w-sys-responsiveness", "Multimedia responsiveness = 0", "Removes the 20% CPU reserve for background tasks (SystemResponsiveness). Off: back to 20."},
	{"w-net-throttling", "Disable multimedia network throttling", "Sets NetworkThrottlingIndex to FFFFFFFF. Off: back to 10."},
	{"w-game-dvr", "Disable Game DVR", "Turns off Game DVR background recording: GameDVR_Enabled = 0, GameDVR_FSEBehavior = 2 and the AllowGameDVR policy = 0. Does not touch Game Mode. Off: re-enables it."},
	{"w-game-mode", "Windows Game Mode", "Turns Game Mode on (AutoGameModeEnabled and AllowAutoGameMode = 1). Off: turns it off."},
	{"w-games-task", "Scheduler priority for games", "\"Games\" multimedia profile: Priority 6, Scheduling Category High, SFIO Priority High, GPU Priority 8. Off: Priority 2, Medium, Normal."},
	{"w-hags", "Hardware-accelerated GPU scheduling (HAGS)", "Sets HwSchMode = 2. Requires a restart. Off: HwSchMode = 1."},
	{"w-mpo", "Disable Multiplane Overlay (MPO)", "Sets OverlayTestMode = 5 (what NVIDIA recommends) and also DisableMultiplaneOverlay = 1. Requires a restart. Off: deletes both values."},
	{"w-large-pages", "Large pages for Geometry Dash", "Does two things: marks GeometryDash.exe to use large memory pages (UseLargePages = 1) and gives your Windows user the \"Lock pages in memory\" right, without which Windows ignores that mark. You have to sign out or restart for the right to take effect. The right belongs to your whole user, not just the game. The gain in Geometry Dash is not proven: measure it with the mod's monitor. Off: removes the mark and the right. The switch shows the mark; the right cannot be read from the game."},
	{"kbd-fast", "Keyboard without Windows delays", "Removes what Windows can put between your keyboard and the game. 1) Turns off Filter Keys, which when active delays or ignores key presses on purpose. 2) Turns off the shortcuts for Filter Keys, Sticky Keys and Toggle Keys, so holding Shift or pressing it 5 times does not pop up a prompt in the middle of a level. 3) Sets the repeat delay to minimum and the repeat rate to maximum (only noticeable when holding a key while typing; the game does not use it). 4) In the active power plan, turns off USB selective suspend, so the keyboard and its port do not go to sleep. 5) Unticks 'Allow the computer to turn off this device to save power' on the keyboard and on the USB devices it goes through (hubs and controller), in case one of them ignores point 4; only this point asks for administrator rights, and if you decline the prompt the others still apply. Points 1 to 4 apply immediately without administrator rights. Point 4 belongs to the power plan that is active when you turn it on: if you change plans, turn it off and on. Off: restores what you had (point 5 goes back to ticked, the Windows value). If you already had points 1 to 4 this way, it shows as on; to also apply point 5, turn it off and on. Same if you move the keyboard to another port."},
	{"cpu-light-sleep", "CPU without deep sleep", "In the active power plan: 1) leaves all cores unparked and 2) limits CPU idle to the lightest state, so an idle core (like the one serving the keyboard) wakes up almost instantly. It does NOT put the CPU at 100%: an idle core still shows 0% usage. It applies to all cores and threads at once; Windows does not allow doing it per core. Raises idle power draw and temperature a little, and some CPUs ignore the limit. Does not ask for administrator rights and applies immediately. It belongs to the power plan that is active when you turn it on: if you change plans, turn it off and on. Off: restores what you had. If you already had it this way, it shows as on."},
	{"kbd-meter", "Keyboard meter", "Opens a test: press many keys quickly for 10-20 seconds and it tells you the keyboard's real polling rate (125, 500, 1000 Hz...), the average jitter with which key presses arrive and the worst case. It saves the last measurement so you can compare before and after changing an option. Changes nothing on the PC. It only records the time of each key press, not which key it is, and only while the window is open. It measures the path from USB to the game; the keyboard's internal delay cannot be measured from here. It cannot tell rates above 1000 Hz apart (it will say '1000 Hz or more'), and its precision is about 0.1 ms. While the window is open it uses one core at 100% to watch the keyboard non-stop. It also checks (read-only) whether the keyboard's USB controller uses MSI interrupts, which is the correct mode; if it says 'legacy mode', the mod does not change it."},
	{"kbd-path", "Keyboard connection", "Checks how your keyboard reaches the PC: directly on a motherboard port or through a USB hub (hub, monitor, front panel). A hub in between can add delay and jitter, and moving to a direct port is usually more noticeable than any Windows tweak. Read-only; changes nothing."},
	{"kbd-core", "Dedicated core for the keyboard (experimental)", "Reserves the CPU's last fast physical core (on a 9700X, core 7) for the keyboard: 1) finds the USB controller it is plugged into and pins its interrupt to the first thread of that core, with high priority; the sibling thread is left empty. 2) Removes that core from the game's cores, also in 'No core 0 and no SMT' and in the external watchdog. It adapts to each PC; if the CPU has too few cores it is not applied. Asks for administrator rights and you must RESTART. Affects everything plugged into that same USB controller (mouse, headset...). If you move the keyboard to a port on another controller, turn the option off and on. Experimental: there is no measurement proving it lowers input lag, and the game loses a core. Off: deletes those values and gives the core back to the game. If you already had an affinity set by hand on that controller, it is replaced."},
	{"w-kbd-queue", "Keyboard queue at 100", "Sets KeyboardDataQueueSize = 100, the Windows value, in case some guide changed it. On means it is already at 100 (or untouched). Requires a restart. Cannot be undone from here: the mod does not know what value was there before."},
	{"w-mouse-queue", "Mouse queue at 100", "Sets MouseDataQueueSize = 100, the Windows value, in case some guide changed it. On means it is already at 100 (or untouched). Requires a restart. Cannot be undone from here: the mod does not know what value was there before."},
	{"w-dynamic-tick", "Disable dynamic tick", "bcdedit: disabledynamictick yes and useplatformtick no. Requires a restart. Off: deletes both boot values."},
	{"nvidia-detected", "NVIDIA graphics card detected", "Automatic indicator: the mod sets it by itself when the game opens, based on the PC's graphics cards. If it is off, the three NVIDIA options are locked."},
	{"w-nv-power", "NVIDIA: maximum performance", "DisplayPowerSaving = 0 and DisableDynamicPstate = 1: the card does not lower its frequency by itself. Uses more power and runs hotter. Requires a restart. Off: deletes the values."},
	{"w-nv-telemetry", "NVIDIA: disable telemetry", "Turns off sending usage data to NVIDIA and removes NvBackend from startup. Off: deletes the values (NvBackend is not restored)."},
	{"w-nv-tasks", "NVIDIA: disable telemetry tasks", "Disables the scheduled tasks NvTmRep_CrashReport1, 2 and 3 and NvTmMon. Off: enables them again. Their state cannot be read from the game."},
	{"w-telemetry", "Disable Windows telemetry", "AllowTelemetry = 0 and the DiagTrack and dmwappushservice services disabled. Off: deletes the policy and re-enables the services."},
	{"w-activity", "Disable activity history", "EnableActivityFeed, PublishUserActivities and UploadUserActivities = 0. Off: deletes the values."},
	{"w-advertising", "Disable advertising ID", "Turns off the advertising ID and content suggestions. Off: re-enables them."},
	{"w-background-apps", "Disable background apps", "GlobalUserDisabled = 1 and LetAppsRunInBackground = 2. Off: deletes the values."},
	{"w-svc-sysmain", "Disable SysMain (Superfetch)", "Disables the SysMain service. Off: back to automatic start."},
	{"w-svc-search", "Disable Windows Search indexer", "Disables the WSearch service: file search works without an index. Off: back to delayed automatic start."},
	{"w-svc-print", "Disable print spooler", "Disables the Spooler service: you cannot print. Off: back to automatic start."},
	{"w-svc-fax", "Disable Fax, Remote Registry and Retail Demo", "Disables those three services. Off: Fax and Retail Demo go back to manual; Remote Registry stays disabled, which is how Windows ships."},
	{"w-svc-diag", "Disable diagnostic services", "Disables DiagTrack, WerSvc, WdiServiceHost and the diagnostics collector. Off: DiagTrack automatic, the others manual."},
	{"w-vbs", "Disable VBS / Memory integrity", "Removes a Windows security protection in exchange for some performance. Requires a restart. Off: turns it on again."},
	{"t-looks", "Looks", ""},
	{"tp-on", "Use texture pack", "Turns the texture pack below on or off without clearing the path. Off: the game uses its normal textures (and the pack's colors are not applied). Applies after restarting the game."},
	{"tp-gray", "Gray theme (black and white packs)", "For black and white packs like yours: the mod turns gray what the game colors through code and a pack cannot change (lists, level info, comments, profile, garage, daily, pause, editor, brown boxes...), makes the main level selector white, the editor buttons black, and fixes the blue box in chests. Off: the pack shows as it is, with the game's colors. Only works with a pack loaded from here. Applies after restarting the game."},
	{"tp-pack", "Texture pack (.zip)", "Pick the .zip of a texture pack (like the ones for Texture Loader). It is unzipped only once into the mod's folder (again only if you change the zip) and handed to the game as a priority folder: after that it does no extra work. Pack folders for other mods also work. To remove it, clear the path. Applies after restarting the game. Turn off Geode's Texture Loader so they do not clash. If a pack sprite sheet is missing a sprite, the game's own is used. It also makes the level search boxes black."},
	{"menu-bg", "Menu background (image)", "A PNG or JPG image of yours as the main menu background. It is fitted to cover the whole screen without stretching. The menu's animated background scene (the running icons), which costs performance even when hidden, is also stopped. It is read from disk only once. To remove it, clear the path. Shows when you return to the menu."},
	{"menu-bg-others", "Background in other menus too", "Uses the same image instead of the blue gradient on the create screen, level lists and search, level info, level lists and leaderboards."},
	{"menu-bg-dim", "Darken background (%)", "Puts a black layer over your image so buttons and text are easier to read. 0 = the image as is."},
	{"t-status", "Status button", ""},
	{"status-menu", "Show in the main menu", "Shows the \"Optimizer: status\" button in the main menu."},
	{"status-pause", "Show in the pause menu", "Shows the \"Optimizer: status\" button in the pause menu."},
};
